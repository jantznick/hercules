DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hercules?schema=public"
SESSION_SECRET="change-this-in-development"
PORT=3001
NODE_ENV=development

# CORS allowlist — comma-separated origins
FRONTEND_URLS="http://localhost:5173"
# Or set individually when FRONTEND_URLS is unset:
# FRONTEND_URL="http://localhost:5173"

# Magic-link emails use FRONTEND_URL for /login?token=...
# Production:
# FRONTEND_URLS="https://your-app.example.com"
# COOKIE_DOMAIN=.your-app.example.com

# Optional: magic-link email via Resend (dev logs tokens to console if unset)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Hercules <onboarding@resend.dev>"
