# --- Database (local: docker-compose.yml) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hercules?schema=public"

# --- API session / server ---
SESSION_SECRET="change-this-in-development"
PORT=3001
NODE_ENV=development

# --- CORS allowlist (comma-separated browser origins) ---
FRONTEND_URLS="http://localhost:5173"
# Or a single origin when FRONTEND_URLS is unset:
# FRONTEND_URL="http://localhost:5173"

# Magic-link emails and Tidal post-OAuth redirects use the first FRONTEND_URLS entry
# (or FRONTEND_URL).

# --- Production (Railway) — see docs/RAILWAY.md ---
# NODE_ENV=production
# SESSION_SECRET=<long-random-string>
# DATABASE_URL=<Railway Postgres plugin reference>
# FRONTEND_URLS="https://<web>.up.railway.app"
# COOKIE_DOMAIN=   # leave unset across *.up.railway.app; set .yourdomain.com when api+web share a parent
# Production cookies: secure + sameSite=none (apps/api/src/lib/sessionCookie.ts)

# --- Frontend (Vite) — build-time only ---
# Local: leave unset → Vite proxies /api → :3001
# Production web image / Railway web service:
# VITE_API_URL="https://<api>.up.railway.app"

# --- Resend (magic-link email) ---
# Required when NODE_ENV=production. In development, unset keys print tokens to the API console.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL="Hercules <onboarding@resend.dev>"
# Production: use a verified sender, e.g. "Hercules <noreply@yourdomain.com>"

# --- Tidal OAuth (https://developer.tidal.com/) ---
# Redirect URI must match the Tidal app registration exactly (character-for-character).
# Local (via Vite proxy to api):
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_REDIRECT_URI="http://localhost:5173/api/tidal/callback"
# Production (API public HTTPS — not the SPA host):
# TIDAL_REDIRECT_URI="https://api.hercules.nickjantz.com/api/tidal/callback"
# Scopes must be enabled on the Tidal app. Default: search.read playback
# Do not use legacy r_usr / w_usr — they often cause authorize Error 1002.
# TIDAL_SCOPES="search.read playback"
# Optional catalog country (ISO 3166-1 alpha-2) for Open API search/track calls
# TIDAL_COUNTRY_CODE=US
# Encrypt Tidal tokens at rest (defaults to SESSION_SECRET if unset)
# TOKEN_ENCRYPTION_KEY=
