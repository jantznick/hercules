{
  "name": "hercules",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run dev -w @hercules/api",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "build": "tsc -b && vite build",
    "build:api": "npm run build -w @hercules/api",
    "typecheck:api": "npm run typecheck -w @hercules/api",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "prisma generate --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.19.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
